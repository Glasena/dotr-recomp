+// Fills a link the first time its successor is found built and bound (out of line: linkNext() keeps no local whose
+// address escapes, so its calls stay tail calls).
+[[gnu::noinline]] bool Vu1Aot::resolveLink(VU1Interpreter &s, Vu1AotRun &r, void *resolved, uint32_t pair)
+{
+    DirectIds::Link &link = *static_cast<DirectIds::Link *>(resolved);
+    using FastBlock = VU1Interpreter::FastBlock;
+    DirectIds &ids = *static_cast<DirectIds *>(r.ids);
+    if (pair >= s.m_fastBlocks.size() || !s.m_fastBlocks[pair] || pair >= ids.aot.size() || !ids.aot[pair])
+        return false;
+    const FastBlock &from = *s.m_fastBlock;
+    const FastBlock &to = *s.m_fastBlocks[pair];
+    DirectIds::Chain chain;
+    resolveChain(from, to, pair, &chain);
+    link.to = &to;
+    link.issue = to.issue.data();
+    link.elide = !noElide && !ids.elide[pair].empty() ? ids.elide[pair].data() : nullptr;
+    link.last = to.issue.back();
+    link.fail = chain.fail;
+    link.fdivReq = static_cast<int32_t>(to.fdivReq);
+    link.efuReq = static_cast<int32_t>(to.efuReq);
+    link.waitPReq = static_cast<int32_t>(to.waitPReq);
+    link.restCount = static_cast<uint16_t>(chain.rest.size()); // at most one per liveIn lane
+    for (const VU1Interpreter::FastReady &w : to.exitReady)
+        link.lateMax = std::max(link.lateMax, w.offset);
+    link.rest = chain.rest.data(); // the vector's buffer survives the move into the list
+    ids.linkChains.push_back(std::move(chain));
+    link.fn = ids.aot[pair];
+    return true;
+}
