+    // LQ/SQ/ILW/ISW with an odd offset use vi14 (0x50, never written) as the base instead of vi0, with the same
+    // address: covers a non-zero base and negative offsets without drawing more random numbers (#44).
+    uint32_t varyBase(uint32_t lower)
+    {
+        const uint32_t opHi = lower >> 25;
+        if ((opHi != 0x00u && opHi != 0x01u && opHi != 0x04u && opHi != 0x05u) || (lower & 1u) == 0u)
+            return lower;
+        const uint32_t baseShift = opHi == 0x01u ? 16u : 11u; // SQ: it is the base; LQ/ILW/ISW: is
+        const uint32_t imm = (lower & 0x7FFu) - kIlwrQword;
+        return (lower & ~0x7FFu & ~(0xFu << baseShift)) | (14u << baseShift) | (imm & 0x7FFu);
+    }
+
