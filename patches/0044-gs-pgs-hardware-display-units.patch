+    // HLE sceGsSetDefDBuff/DefDBuffDc/DefDispEnv (used by the movie player, #51) write DISPLAY in the CPU
+    // backend's units: MAGH=0, DW=width-1 pixels, DH=height-1 buffer lines, DY=32. Hardware counts DW in VCK
+    // (MAGH+1 per pixel) and, in interlaced frame mode, DH in raster lines, so paraLLEl-GS scanned the movie out
+    // at a quarter width and half height. Rewrite such values as libgraph's NTSC ones (636, 50, MAGH=2560/w-1).
+    // ponytail: MAGH=0 with DW < 1024 is taken as HLE-written; no real NTSC display is that narrow.
+    uint64_t hardwareDisplay(uint64_t display, uint64_t smode2)
+    {
+        const uint64_t dw = (display >> 32) & 0xfff, dh = (display >> 44) & 0x7ff, magh = (display >> 23) & 15;
+        if (magh != 0 || dw >= 1024)
+            return display;
+        const uint64_t width = dw + 1, newMagh = std::max<uint64_t>(1, 2560 / width) - 1;
+        const bool interlaced = smode2 & 1, frameMode = (smode2 >> 1) & 1;
+        const uint64_t lines = interlaced && frameMode ? (dh + 1) * 2 : dh + 1;
+        const uint64_t dy = interlaced ? 50 : 25;
+        return 636 | (dy << 12) | (newMagh << 23) | ((width * (newMagh + 1) - 1) << 32) | ((lines - 1) << 44);
+    }
