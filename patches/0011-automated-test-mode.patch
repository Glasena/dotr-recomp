diff --git a/ps2xRuntime/include/runtime/ps2_test_mode.h b/ps2xRuntime/include/runtime/ps2_test_mode.h
new file mode 100644
index 0000000..f749774
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_test_mode.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <cstdint>
+
+class PS2Runtime;
+
+// Env-driven automated test mode (all off by default):
+//   PS2X_HEADLESS=1        hidden window, no audio device
+//   PS2X_UNCAPPED=1        VBlanks/timers run as fast as the EE allows (no wall-clock pacing)
+//   PS2X_INPUT_SCRIPT=...  "start@300,cross@900": hold a pad button for 10 VBlanks starting at VBlank N
+//   PS2X_DUMP_FRAMES=...   "300,900": write the displayed frame as PNG at those VBlanks
+//   PS2X_DUMP_DIR=dir      where dumps go (default "."), as frame_<N>.png
+//   PS2X_EXIT_AT=N         exit the process at VBlank N
+namespace ps2x::test
+{
+    bool headless();
+    bool uncapped();
+    // PS2 pad button bits (active high) the script holds at the current VBlank.
+    uint16_t scriptedButtons();
+    // Called by the EE scheduler on every VBlankStart, after the tick is incremented.
+    void onVBlank(PS2Runtime &runtime, uint64_t tick);
+}
diff --git a/ps2xRuntime/src/lib/ps2_test_mode.cpp b/ps2xRuntime/src/lib/ps2_test_mode.cpp
new file mode 100644
index 0000000..f31d6bc
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_test_mode.cpp
@@ -0,0 +1,119 @@
+#include "runtime/ps2_test_mode.h"
+#include "ps2_runtime.h"
+#include "raylib.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <iostream>
+#include <set>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace
+{
+    constexpr uint64_t kHoldVBlanks = 10u;
+
+    bool envFlag(const char *name)
+    {
+        const char *v = std::getenv(name);
+        return v && *v && std::string(v) != "0";
+    }
+
+    uint16_t buttonBit(const std::string &name)
+    {
+        static const std::pair<const char *, uint16_t> kButtons[] = {
+            {"select", 0x0001}, {"l3", 0x0002}, {"r3", 0x0004}, {"start", 0x0008},
+            {"up", 0x0010}, {"right", 0x0020}, {"down", 0x0040}, {"left", 0x0080},
+            {"l2", 0x0100}, {"r2", 0x0200}, {"l1", 0x0400}, {"r1", 0x0800},
+            {"triangle", 0x1000}, {"circle", 0x2000}, {"cross", 0x4000}, {"square", 0x8000}};
+        for (const auto &[n, bit] : kButtons)
+            if (name == n)
+                return bit;
+        std::cerr << "[test] unknown button '" << name << "' in PS2X_INPUT_SCRIPT" << std::endl;
+        return 0;
+    }
+
+    struct Config
+    {
+        bool headless = envFlag("PS2X_HEADLESS");
+        bool uncapped = envFlag("PS2X_UNCAPPED");
+        std::vector<std::pair<uint64_t, uint16_t>> presses; // (start VBlank, button bit)
+        std::set<uint64_t> dumps;
+        std::string dumpDir = std::getenv("PS2X_DUMP_DIR") ? std::getenv("PS2X_DUMP_DIR") : ".";
+        uint64_t exitAt = std::getenv("PS2X_EXIT_AT") ? std::strtoull(std::getenv("PS2X_EXIT_AT"), nullptr, 10) : 0u;
+
+        Config()
+        {
+            std::string item;
+            if (const char *s = std::getenv("PS2X_INPUT_SCRIPT"))
+                for (std::istringstream in(s); std::getline(in, item, ',');)
+                {
+                    const size_t at = item.find('@');
+                    if (at != std::string::npos)
+                        presses.emplace_back(std::strtoull(item.c_str() + at + 1, nullptr, 10), buttonBit(item.substr(0, at)));
+                }
+            if (const char *s = std::getenv("PS2X_DUMP_FRAMES"))
+                for (std::istringstream in(s); std::getline(in, item, ',');)
+                    dumps.insert(std::strtoull(item.c_str(), nullptr, 10));
+        }
+    };
+
+    const Config &config()
+    {
+        static const Config c;
+        return c;
+    }
+
+    std::atomic<uint64_t> g_tick{0};
+
+    void dumpFrame(PS2Runtime &runtime, uint64_t tick)
+    {
+        std::vector<uint8_t> pixels;
+        uint32_t w = 0, h = 0;
+        runtime.gs().latchHostPresentationFrame();
+        if (!runtime.gs().copyLatchedHostPresentationFrame(pixels, w, h) || w == 0 || h == 0)
+        {
+            std::cerr << "[test] vblank " << tick << ": no frame to dump" << std::endl;
+            return;
+        }
+        for (size_t i = 3; i < pixels.size(); i += 4)
+            pixels[i] = 0xFF; // GS alpha is not display alpha
+        Image img{pixels.data(), static_cast<int>(w), static_cast<int>(h), 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+        const std::string path = config().dumpDir + "/frame_" + std::to_string(tick) + ".png";
+        if (ExportImage(img, path.c_str()))
+            std::cerr << "[test] vblank " << tick << ": dumped " << path << " (" << w << "x" << h << ")" << std::endl;
+    }
+}
+
+namespace ps2x::test
+{
+    bool headless() { return config().headless; }
+    bool uncapped() { return config().uncapped; }
+
+    uint16_t scriptedButtons()
+    {
+        const uint64_t tick = g_tick.load(std::memory_order_relaxed);
+        uint16_t bits = 0;
+        for (const auto &[start, bit] : config().presses)
+            if (tick >= start && tick < start + kHoldVBlanks)
+                bits |= bit;
+        return bits;
+    }
+
+    void onVBlank(PS2Runtime &runtime, uint64_t tick)
+    {
+        g_tick.store(tick, std::memory_order_relaxed);
+        const Config &c = config();
+        if (c.dumps.count(tick))
+            dumpFrame(runtime, tick);
+        if (c.exitAt != 0u && tick >= c.exitAt)
+        {
+            std::cerr << "[test] exit at vblank " << tick << std::endl;
+            std::fflush(nullptr);
+            std::_Exit(0);
+        }
+    }
+}
