+    template <typename Draw>
+    void runRasterBand(uint32_t index, uint32_t count, Draw &&draw)
+    {
+        thread_local GSMem::TexturePageCache cache;
+        cache.Invalidate();
+        t_textureCache = &cache;
+        t_rasterIndex = index;
