+void GSCpuBackend::DrawPrimitiveParallel(const GSPrimitiveBatch &batch)
+{
+    {
+        std::lock_guard<std::mutex> lock(m_rasterMutex);
+        m_rasterBatch = &batch;
+        m_rasterRounding = std::fegetround();
+        m_rasterPending = static_cast<uint32_t>(m_rasterWorkers.size());
+        ++m_rasterGeneration;
+    }
+    m_rasterStart.notify_all();
+    runRasterBand(0u, static_cast<uint32_t>(m_rasterWorkers.size() + 1u), [&]()
+                  {
+                      if (batch.state.prim.type == GS_PRIM_SPRITE)
+                          DrawSprite(batch);
+                      else
+                          DrawTriangle(batch); });
+    std::unique_lock<std::mutex> lock(m_rasterMutex);
+    m_rasterDone.wait(lock, [this]()
+                      { return m_rasterPending == 0u; });
 }
 
