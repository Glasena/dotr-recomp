+void GSCpuBackend::RasterWorkerLoop(uint32_t index)
+{
+    uint64_t seen = 0;
+    for (;;)
+    {
+        const GSPrimitiveBatch *batch = nullptr;
+        int rounding = 0;
+        {
+            std::unique_lock<std::mutex> lock(m_rasterMutex);
+            m_rasterStart.wait(lock, [&]()
+                               { return m_rasterStop || m_rasterGeneration != seen; });
+            if (m_rasterStop)
+                return;
+            seen = m_rasterGeneration;
+            batch = m_rasterBatch;
+            rounding = m_rasterRounding;
+        }
+        // The caller may be inside the VU1 interpreter, which rasterizes with round-toward-zero.
+        std::fesetround(rounding);
+        runRasterBand(index, static_cast<uint32_t>(m_rasterWorkers.size() + 1u), [&]()
+                      {
+                          if (batch->state.prim.type == GS_PRIM_SPRITE)
+                              DrawSprite(*batch);
+                          else
+                              DrawTriangle(*batch); });
+        bool last = false;
+        {
+            std::lock_guard<std::mutex> lock(m_rasterMutex);
+            last = --m_rasterPending == 0u;
+        }
+        if (last)
+            m_rasterDone.notify_one();
+    }
+}
