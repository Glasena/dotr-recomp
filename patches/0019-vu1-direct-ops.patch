index ed0ee71..6e238af 100644
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_detail.h
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_detail.h
@@ -26,4 +26,54 @@ static inline int16_t IMM15(uint32_t i)
     return (int16_t)(int32_t)((int32_t)(raw << 17) >> 17);
 }
 
+// Direct handlers for the fast-block path. Ids are stored beside the decoded cache (see ps2_vu1_core.cpp);
+// execUpper/execLower keep their own switches for the interpreter and PS2X_VU_NO_DIRECT.
+#ifndef PS2_VU1_H
+class VU1Interpreter;
+#endif
+
+constexpr uint16_t kVu1UpperReserved = 0xC0;
+constexpr uint16_t kVu1UpperFnCount = kVu1UpperReserved + 1u;
+constexpr uint16_t kVu1LowerNop = 0;
+constexpr uint16_t kVu1LowerReserved = 0x1C0;
+constexpr uint16_t kVu1LowerFnCount = kVu1LowerReserved + 1u;
+
+using Vu1UpperFn = void (*)(VU1Interpreter &self, uint32_t instr);
+using Vu1LowerFn = void (*)(VU1Interpreter &self, uint32_t instr, uint8_t *vuData, uint32_t dataSize);
+
+extern Vu1UpperFn g_vu1UpperFn[kVu1UpperFnCount];
+extern Vu1LowerFn g_vu1LowerFn[kVu1LowerFnCount];
+
+inline uint16_t vu1UpperHandlerId(uint32_t instr)
+{
+    const uint32_t low11 = instr & 0x7FFu;
+    if (low11 == 0x2FFu || low11 == 0x33Cu)
+        return static_cast<uint16_t>(0x40u + ((instr & 0x3u) | ((instr >> 4) & 0x7Cu)));
+    const uint8_t op = static_cast<uint8_t>(instr & 0x3Fu);
+    if (op >= 0x3Cu)
+    {
+        const uint8_t special = static_cast<uint8_t>((instr & 0x3u) | ((instr >> 4) & 0x7Cu));
+        return static_cast<uint16_t>(0x40u + special);
+    }
+    if (op > 0x2Fu)
+        return kVu1UpperReserved;
+    return op;
+}
+
+inline uint16_t vu1LowerHandlerId(uint32_t instr)
+{
+    if (instr == 0u || instr == 0x8000033Cu)
+        return kVu1LowerNop;
+    const uint8_t opHi = static_cast<uint8_t>((instr >> 25) & 0x7Fu);
+    if (opHi != 0x40u)
+        return static_cast<uint16_t>(1u + opHi);
+    const uint8_t funct = static_cast<uint8_t>(instr & 0x3Fu);
+    if (funct >= 0x3Cu)
+    {
+        const uint8_t funct2 = static_cast<uint8_t>((instr & 0x3u) | ((instr >> 4) & 0x7Cu));
+        return static_cast<uint16_t>(0x140u + funct2);
+    }
+    return static_cast<uint16_t>(0x100u + funct);
+}
+
 #endif
