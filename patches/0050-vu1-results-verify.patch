+    // PS2X_VU_RESULTS_VERIFY=1 (#57): every VU1 run (MSCAL/MSCNT) also runs on a twin interpreter that binds the
+    // exact generated variant, from a copy of the run state and of VU data, with PATH1 hashed instead of
+    // submitted. VF/VI/ACC/Q/P/I/R/CLIP, pc, end state, VU data and the hash of the XGKICK packets must match;
+    // cycles and MAC/status are not compared. The twin keeps its own MAC/status from its previous (exact) runs, so
+    // a reader of a flag write the relaxed code dropped shows up as a VI mismatch.
+    const bool g_resultsVerify = std::getenv("PS2X_VU_RESULTS_VERIFY") != nullptr;
+    struct ResultsVerify
+    {
+        std::unique_ptr<VU1Interpreter> twin;
+        uint64_t packetHash = 1469598103934665603ull; // fnv1a of the PATH1 packets of the current run
+        bool isTwin = false, nested = false;
+    };
+    std::unordered_map<const VU1Interpreter *, ResultsVerify> g_resultsVerifyState;
+    struct ResultsVerifyStats
+    {
+        uint64_t checks = 0, mismatches = 0;
+        std::map<uint32_t, uint64_t> byPc; // run start pc -> mismatches
+    } g_resultsVerifyStats;
+
+    void printResultsVerifyStats()
+    {
+        const ResultsVerifyStats &v = g_resultsVerifyStats;
+        std::fprintf(stderr, "[vu1:results-verify] runs=%llu mismatches=%llu", static_cast<unsigned long long>(v.checks),
+                     static_cast<unsigned long long>(v.mismatches));
+        for (const auto &[pc, n] : v.byPc)
+            std::fprintf(stderr, " 0x%04x=%llu", pc, static_cast<unsigned long long>(n));
+        std::fprintf(stderr, "\n");
+        std::fflush(stderr);
+    }
