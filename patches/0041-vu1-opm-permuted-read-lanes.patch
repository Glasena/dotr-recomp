+// OPMULA/OPMSUB (cross product) read fs.yzx and ft.zxy: dest lane x reads fs.y/ft.z, y reads fs.z/ft.x,
+// z reads fs.x/ft.y. w reads fs.w/ft.w (its product only feeds the sticky flags, calculateFmacProductSticky).
+// Lane bits: x=8, y=4, z=2, w=1.
+static uint8_t opmFsLanes(uint8_t dest)
+{
+    return static_cast<uint8_t>(((dest & 8u) ? 4u : 0u) | ((dest & 4u) ? 2u : 0u) | ((dest & 2u) ? 8u : 0u) |
+                                (dest & 1u));
+}
+
+static uint8_t opmFtLanes(uint8_t dest)
+{
+    return static_cast<uint8_t>(((dest & 8u) ? 2u : 0u) | ((dest & 4u) ? 8u : 0u) | ((dest & 2u) ? 4u : 0u) |
+                                (dest & 1u));
+}
