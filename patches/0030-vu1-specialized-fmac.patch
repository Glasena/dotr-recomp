+// VU1Interpreter::normalizeOperand() on four lanes: exponent 0 -> signed zero, exponent 255 -> signed FLT_MAX.
+static inline __m128 vu1NormalizeOperands(__m128 value)
+{
+    const __m128i bits = _mm_castps_si128(value);
+    const __m128i exponentMask = _mm_set1_epi32(0x7F800000);
+    const __m128i exponent = _mm_and_si128(bits, exponentMask);
+    const __m128i sign = _mm_and_si128(bits, _mm_set1_epi32(static_cast<int>(0x80000000u)));
+    const __m128i zero = _mm_cmpeq_epi32(exponent, _mm_setzero_si128());
+    const __m128i huge = _mm_cmpeq_epi32(exponent, exponentMask);
+    __m128i out = _mm_or_si128(_mm_andnot_si128(zero, bits), _mm_and_si128(zero, sign));
+    out = _mm_or_si128(_mm_andnot_si128(huge, out),
+                       _mm_and_si128(huge, _mm_or_si128(sign, _mm_set1_epi32(0x7F7FFFFF))));
+    return _mm_castsi128_ps(out);
+}
