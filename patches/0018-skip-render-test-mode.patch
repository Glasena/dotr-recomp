+namespace
+{
+    // VIF runs MSCAL/MSCNT synchronously, so returning here already reports VU1 idle
+    // (VPU_STAT VDS1/VTS1 stay clear). The microprogram's PATH1 GIF packet never runs,
+    // so its FINISH write would not either; set CSR FINISH the way that packet would.
+    bool skippedVu1(VU1Interpreter::Unit unit, GS &gs)
+    {
+        if (unit != VU1Interpreter::Unit::VU1 || !ps2x::test::skipRender())
+            return false;
+        gs.writeRegister(GS_REG_FINISH, 0);
+        return true;
+    }
+}
