+    bool skipRender()
+    {
+        const Config &c = config();
+        if (!c.skipRender)
+            return false;
+        const uint64_t tick = g_tick.load(std::memory_order_relaxed);
+        // Drawing after onVBlank(tick) is what a later vblank latches. Keep the `warmup`
+        // ticks before each dump (tick < dump && dump - tick <= warmup).
