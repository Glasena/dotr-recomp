+// The lanes' ready cycles of a block's exit writes, for the block started at `start`.
+inline void Vu1Aot::recordWrites(VU1Interpreter &s, const std::vector<VU1Interpreter::FastReady> &writes,
+                                 uint64_t start)
+{
+    for (const VU1Interpreter::FastReady &w : writes)
+    {
+        const uint64_t ready = start + w.offset;
+        if (w.kind == 0u)
+        {
+            s.m_vfReady[w.reg][w.component] = ready;
+            s.m_vfRegReadyMax[w.reg] = std::max(s.m_vfRegReadyMax[w.reg], ready);
+        }
+        else if (w.kind == 1u)
+            s.m_viReady[w.reg] = ready;
+        else
+            s.m_accReady[w.component] = ready;
+        s.m_regReadyMax = std::max(s.m_regReadyMax, ready);
+    }
+}
+
+// exitFastBlock() for a block that ran to its end: its register writes become the lanes' ready cycles.
+inline void Vu1Aot::recordExit(VU1Interpreter &s, const VU1Interpreter::FastBlock &block)
+{
+    // When nothing from before the block can still stall (m_regReadyMax <= now), ready cycles already passed are
+    // equivalent to any other past cycle, so only the writes still pending need recording.
+    recordWrites(s, s.m_regReadyMax <= s.m_cycle ? block.exitLate : block.exitReady, s.m_fastStart);
+}
