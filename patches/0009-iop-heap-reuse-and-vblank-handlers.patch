+    void IopVblank::serviceDue(uint64_t currentCycle, IopGuestExecutor &executor)
+    {
+        if (m_servicing || m_handlers.empty())
+            return;
+        m_servicing = true;
+        for (uint32_t edge = 0u; edge < 2u; ++edge)
+        {
+            if (m_nextEdge[edge] == 0u || m_nextEdge[edge] > currentCycle)
+                continue;
+            // One delivery per serviced edge; missed fields are dropped like a late VBLANK interrupt.
+            while (m_nextEdge[edge] <= currentCycle)
+                m_nextEdge[edge] += kVblankPeriodCycles;
+            const std::vector<Handler> handlers = m_handlers; // handlers may (un)register
+            for (const Handler &handler : handlers)
+                if (handler.edge == edge && handler.function != 0u)
+                    (void)executor.executeGuestFunctionWithBudget(handler.function, handler.argument, 0u, 0u, 0u,
+                                                                  handler.gp, 100000u);
+        }
+        m_servicing = false;
+    }
+
+    uint64_t IopVblank::nextEventCycle(uint64_t fallback) const noexcept
+    {
+        uint64_t next = fallback;
+        for (uint32_t edge = 0u; edge < 2u; ++edge)
+            for (const Handler &handler : m_handlers)
+                if (handler.edge == edge && m_nextEdge[edge] != 0u)
+                {
+                    next = std::min(next, m_nextEdge[edge]);
+                    break;
+                }
+        return next;
+    }
 }
