+void ps2x::test::packWindowFrame(const std::vector<uint8_t> &frame, uint32_t width, uint32_t height,
+                                 std::vector<uint8_t> &out)
+{
+    out.assign(DEFAULT_FB_SIZE, 0u);
+    const uint32_t copyWidth = std::min<uint32_t>(width, FB_WIDTH);
+    const uint32_t copyHeight = std::min<uint32_t>(height, FB_HEIGHT);
+    for (uint32_t y = 0; y < copyHeight; ++y)
+    {
+        const size_t src = static_cast<size_t>(y) * width * 4u;
+        if (src + copyWidth * 4u > frame.size())
+            break;
+        uint8_t *dst = out.data() + static_cast<size_t>(y) * FB_WIDTH * 4u;
+        std::memcpy(dst, frame.data() + src, copyWidth * 4u);
+        // #60: GS alpha is not display alpha. The window draws the texture alpha-blended over black, so a backend
+        // that leaves GS alpha in its scanout (pgs: the movie's IMAGE alpha 0) showed black.
+        for (uint32_t x = 0; x < copyWidth; ++x)
+            dst[x * 4u + 3u] = 0xFF;
+    }
+}
