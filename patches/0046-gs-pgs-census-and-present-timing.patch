+                static const char *dir[] = {"trx=host->local", "trx=local->host", "trx=local->local", "trx=off"};
+                const uint64_t trx = reg[GS_REG_TRXREG];
+                add(dir[value & 3]);
+                add(std::string(dir[value & 3]) + " px", (trx & 0xfff) * ((trx >> 32) & 0xfff));
+            }
+        }
+
+        void kick()
+        {
+            static const unsigned need[8] = {1, 2, 2, 3, 3, 3, 2, 0};
+            const unsigned type = reg[GS_REG_PRIM] & 7;
+            if (type == 7 || ++vertices < need[type])
+                return;
+            if (type == 0 || type == 1 || type == 3 || type == 6)
+                vertices = 0;
+            static const char *names[8] = {"point", "line", "linestrip", "tri", "tristrip", "trifan", "sprite", ""};
+            const uint64_t attr = (reg[GS_REG_PRMODECONT] & 1) ? reg[GS_REG_PRIM] : reg[GS_REG_PRMODE];
+            const unsigned ctxt = (attr >> 9) & 1;
+            add(std::string("prim=") + names[type]);
+            const unsigned fpsm = (reg[GS_REG_FRAME_1 + ctxt] >> 24) & 63;
+            add("fpsm=" + psmName(fpsm));
+            const uint64_t test = reg[GS_REG_TEST_1 + ctxt];
+            if ((test >> 16) & 1)
+                add("zte zpsm=" + psmName(0x30 | ((reg[GS_REG_ZBUF_1 + ctxt] >> 24) & 15)) + " ztst=" +
+                    std::to_string((test >> 17) & 3) + ((reg[GS_REG_ZBUF_1 + ctxt] >> 32) & 1 ? " zmsk" : ""));
+            if (test & 1)
+                add("ate atst=" + std::to_string((test >> 1) & 7) + " afail=" + std::to_string((test >> 12) & 3));
+            if ((test >> 14) & 1)
+                add("date");
+            if ((attr >> 4) & 1)
+            {
+                const uint64_t tex0 = reg[GS_REG_TEX0_1 + ctxt];
+                const unsigned tpsm = (tex0 >> 20) & 63;
+                add("tme tpsm=" + psmName(tpsm) + " tfx=" + std::to_string((tex0 >> 35) & 3) +
+                    " tcc=" + std::to_string((tex0 >> 34) & 1) +
+                    (tpsm >= GS_PSM_T8 && tpsm != GS_PSM_Z32 ? " cpsm=" + psmName((tex0 >> 51) & 15) : ""));
+                add("tex1 mmag=" + std::to_string((reg[GS_REG_TEX1_1 + ctxt] >> 5) & 1) +
+                    " mmin=" + std::to_string((reg[GS_REG_TEX1_1 + ctxt] >> 6) & 7));
+            }
+            if ((attr >> 5) & 1)
+                add("fge");
+            if ((attr >> 6) & 1)
+            {
+                char alpha[32];
+                std::snprintf(alpha, sizeof(alpha), "abe alpha=%llx", (unsigned long long)reg[GS_REG_ALPHA_1 + ctxt]);
+                add(alpha);
+                if (reg[GS_REG_PABE] & 1)
+                    add("pabe");
+            }
+            if ((attr >> 7) & 1)
+                add("aa1");
+            if (reg[GS_REG_DTHE] & 1)
+                add("dthe");
+            if (reg[GS_REG_FBA_1 + ctxt] & 1)
+                add("fba");
+            if (!(reg[GS_REG_COLCLAMP] & 1))
+                add("colclamp=0");
+            if (reg[GS_REG_FRAME_1 + ctxt] >> 32)
+                add("fbmsk");
+        }
+
+        void present(uint64_t index)
+        {
+            for (const auto &[key, n] : frame)
+                if (seen[key]++ == 0)
+                    std::cerr << "[pgs-census] present " << index << " new: " << key << std::endl;
+            if (index % 60 == 0)
+            {
+                std::cerr << "[pgs-census] present " << index << ":";
+                for (const auto &[key, n] : frame)
+                    std::cerr << " {" << key << "}=" << n;
+                std::cerr << std::endl;
+            }
+            frame.clear();
+        }
+    };
