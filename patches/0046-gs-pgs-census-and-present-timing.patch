+
+        void write(uint8_t addr, uint64_t value)
+        {
+            addr &= 127;
+            if (addr == GS_REG_XYZF2 || addr == GS_REG_XYZ2)
+                return kick();
+            if (addr == GS_REG_XYZF3 || addr == GS_REG_XYZ3)
+            {
+                ++vertices;
+                return;
+            }
