+    // applyDest() with the dest field as a constant.
+    template <uint8_t Dest>
+    [[gnu::always_inline]] static inline void storeDest(float *dst, __m128 value)
+    {
+        if constexpr (Dest == 0xFu)
+            _mm_storeu_ps(dst, value);
+        else if constexpr (Dest != 0u)
+        {
+            const __m128 lanes = _mm_load_ps(reinterpret_cast<const float *>(vu1fast::kDestLanes[Dest]));
+            _mm_storeu_ps(dst, _mm_or_ps(_mm_and_ps(lanes, value), _mm_andnot_ps(lanes, _mm_loadu_ps(dst))));
+        }
+    }
