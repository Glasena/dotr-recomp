+    // VU1Interpreter::queueClip() with the free entry found from m_flagMask, as queueFlags().
+    static inline void queueClip(VU1Interpreter &s, uint32_t clip)
+    {
+        const uint32_t freeIndex = static_cast<uint32_t>(std::countr_one(s.m_flagMask));
+        if (freeIndex >= VU1Interpreter::kMaxFlagEntries)
+        {
+            s.queueClip(clip); // full: reported there
+            return;
+        }
+        s.m_workingClip = ((s.m_workingClip << 6) | (clip & 0x3Fu)) & 0xFFFFFFu;
+        VU1Interpreter::FlagPipelineEntry &entry = s.m_flagPipeline[freeIndex];
+        entry = {};
+        entry.valid = true;
+        entry.issueCycle = s.m_cycle;
+        entry.readyCycle = s.m_cycle + VU1Interpreter::kFmacLatency;
+        s.m_nextCommitCycle = std::min(s.m_nextCommitCycle, entry.readyCycle);
+        s.m_flagMask |= 1u << freeIndex;
+        entry.clip = s.m_workingClip;
+        entry.writesClip = true;
+    }
