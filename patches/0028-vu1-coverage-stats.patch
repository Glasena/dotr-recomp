+    // Called once per execute()/resume() of VU1 after the code cache is ready.
+    void vuStatsBeginRun()
+    {
+        VuStats &s = vuStats();
+        static const bool registered = (std::atexit([] { printVuStats("exit"); }), true);
+        (void)registered;
+        if (s.pendingStart)
+        {
+            s.pendingStart = false;
+            ++s.runs;
+            ++s.images[s.imageHash].starts;
+            VuProgStats &p = s.programs[s.imageHash ^ s.pendingPc];
+            p.image = s.imageHash;
+            p.pc = s.pendingPc;
+            ++p.runs;
+            s.current = &p;
+        }
+        else if (s.pendingResume)
+        {
+            s.pendingResume = false;
+            if (s.current)
+                ++s.current->resumes;
+        }
+        const auto now = std::chrono::steady_clock::now();
+        if (now - s.lastPrint >= std::chrono::seconds(5))
+        {
+            s.lastPrint = now;
+            printVuStats("5s");
+        }
+    }
