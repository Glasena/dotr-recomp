+bool Vu1Aot::enterChained(VU1Interpreter &s, Vu1AotRun &r, uint32_t pair)
+{
+    using FastBlock = VU1Interpreter::FastBlock;
+    const FastBlock &from = *static_cast<const FastBlock *>(r.prev);
+    const FastBlock &to = *s.m_fastBlocks[pair];
+    const uint64_t start = s.m_cycle;
+    DirectIds &ids = *static_cast<DirectIds *>(r.ids);
+    if (ids.chains.size() != s.m_cachedPairCount)
+        ids.chains.resize(s.m_cachedPairCount);
+    std::array<DirectIds::Chain, 2> &slots = ids.chains[from.startPair];
+    DirectIds::Chain *chain = slots[0].to == pair ? &slots[0] : slots[1].to == pair ? &slots[1] : nullptr;
+    if (!chain && (slots[0].to == ~0u || slots[1].to == ~0u))
+    {
+        // From the entry at start = from's start + span: a liveIn lane `from` leaves pending past its span is
+        // ready at from's start + exit offset, so it passes or fails the same way every time. A lane it wrote
+        // earlier is ready by start, whichever of exitReady/exitLate exitFastBlock() recorded. Any other lane
+        // keeps its earlier ready cycle and is checked at entry, as tryEnterFastBlock() does.
+        chain = slots[0].to == ~0u ? &slots[0] : &slots[1];
+        chain->to = pair;
+        const uint32_t span = from.issue.back() + 1u;
+        for (const VU1Interpreter::FastReady &req : to.liveIn)
+        {
+            const auto written = std::find_if(from.exitReady.begin(), from.exitReady.end(),
+                                              [&](const VU1Interpreter::FastReady &w)
+                                              { return w.kind == req.kind && w.reg == req.reg && w.component == req.component; });
+            if (written == from.exitReady.end())
+                chain->rest.push_back({req.offset, req.kind, req.reg, req.component});
+            else if (written->offset > span + req.offset)
+                chain->fail = true;
+        }
+    }
+    if (!chain || start != s.m_fastStart + from.issue.back() + 1u)
+        return s.tryEnterFastBlock(r.budgetEnd);
+
+    // The checks of tryEnterFastBlock() that can fail here, in its order; the others hold after a block ran.
+    const auto refuse = [&](VuRefusal reason)
+    {
+        if (g_vuTrack)
+            vuStatsRefuse(reason, s.m_state.pc);
+        return false;
+    };
+    if (s.m_state.branchPending || s.m_state.haltAfterDelaySlot)
+        return refuse(RefuseBranch);
+    if (s.m_storeMask != 0u)
+        return refuse(RefuseStores);
+    if (start + to.issue.back() + 16u >= r.budgetEnd)
+        return refuse(RefuseBudget);
+    if (chain->fail)
+        return refuse(RefuseLiveIn);
+    if (r.prevReadyMax > start)
+    {
+        for (const DirectIds::ChainReq &req : chain->rest)
+        {
+            if (start + req.offset >= r.prevReadyMax)
+                break; // these lanes kept ready cycles <= r.prevReadyMax
+            const uint64_t ready = req.kind == 0u   ? s.m_vfReady[req.reg][req.component]
+                                   : req.kind == 1u ? s.m_viReady[req.reg]
+                                                    : s.m_accReady[req.component];
+            if (ready > start + req.offset)
+                return refuse(RefuseLiveIn);
+        }
+    }
+    if (to.fdivReq >= 0 && s.m_fdiv.valid && s.m_fdiv.readyCycle > start + static_cast<uint64_t>(to.fdivReq))
+        return refuse(RefuseFdiv);
+    if (to.efuReq >= 0 && s.m_efuResourceReady > start + static_cast<uint64_t>(to.efuReq))
+        return refuse(RefuseEfu);
+    if (to.waitPReq >= 0)
+    {
+        for (const VU1Interpreter::ScalarPipelineEntry &entry : s.m_efu)
+            if (entry.valid && entry.readyCycle > start + static_cast<uint64_t>(to.waitPReq))
+                return refuse(RefuseWaitP);
+    }
+    if ((s.m_vfMask | s.m_viMask | s.m_accMask) != 0u)
+        s.applyPendingRegisterWrites();
+    s.m_fastBlock = &to;
+    s.m_fastIndex = 0;
+    s.m_fastStart = start;
+    s.m_xgkickSyncCycle = s.m_cycle;
+    return true;
+}
