+        target_include_directories(ps2x_vu1_diff_aot PRIVATE "${CMAKE_SOURCE_DIR}/ps2xRuntime/src/lib" "${VU1_SRC}")
+        target_compile_definitions(ps2x_vu1_diff_aot PRIVATE PS2X_VU1_AOT=1 PS2X_VU1_DIFF_AOT=1)
