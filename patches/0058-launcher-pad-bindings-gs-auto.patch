+namespace ps2x::pad
+{
+    // One host binding per PS2 button, indexed by the bit of the active-low button word (0 = Select ... 15 = Square).
+    // keys are raylib KeyboardKey values, button a raylib GamepadButton; 0 = unbound. Keyboard and the first
+    // available gamepad are read together. The sticks map to the raylib left/right stick axes.
+    constexpr int kButtonCount = 16;
+    struct Binding
+    {
+        int keys[2];
+        int button;
+    };
+    Binding &binding(int bit);
+    const char *buttonName(int bit); // "select", "l3", ..., "square" (the PS2X_INPUT_SCRIPT names)
+    void resetBindings();
+}
+
 #endif
