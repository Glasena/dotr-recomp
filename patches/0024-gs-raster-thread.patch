+// Adapted from Tobiichi-Port (GOW-Port) gs_threaded_backend.h, itself adapted from Taylor N. Albarnaz / LightVelox
+// (GPL-3.0), PS2Recomp sotc-port ac9efa070638ad3b3accd284de6f898d5ab271d1.
+#pragma once
+
+#include "runtime/gs/gs_backend.h"
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+// Runs a raster backend on its own thread, in command order. Commands that only change GS state are queued;
+// anything that returns GS state (VRAM reads, snapshots, presentation, local-to-host bytes, Sync/FINISH) waits
+// until the worker has executed everything queued before it. The caller's FP rounding mode travels with the queue.
+// PS2X_GS_THREAD=0 runs the backend inline instead; PS2X_GS_SYNC_STATS=1 prints the waits per sync point every 5 s.
+class GSThreadedBackend final : public GSRasterBackend
+{
+public:
+    explicit GSThreadedBackend(std::unique_ptr<GSRasterBackend> inner);
+    ~GSThreadedBackend() override;
+
+    static bool EnabledByEnv();
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override;
+    void Reset() override;
+
+    void Submit(const GSPrimitiveBatch &batch) override;
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override;
+
+    void BeginTransfer(const GSTransferCommand &command) override;
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override;
+
+    void Flush() override;
+    void TextureFlush() override;
+    void Sync(GSSyncReason reason) override;
+    PresentationFrame Present(const GSPresentationRequest &request) override;
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override;
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override;
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override;
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override;
+    void SnapshotVram(std::vector<uint8_t> &out) const override;
+    GSTransferSnapshot GetTransferSnapshot() const override;
+
+private:
+    enum class Op : uint8_t
+    {
+        Rounding,
+        Submit,
+        LoadClut,
+        BeginTransfer,
+        Upload,
+        Flush,
+        TextureFlush,
+        WriteVram,
+    };
+
+    enum SyncPoint : uint8_t
+    {
+        kInitialize,
+        kReset,
+        kSyncFinish,
+        kSyncLocalToHost,
+        kSyncPresentation,
+        kSyncDebugReadback,
+        kSyncReset,
+        kPresent,
+        kClear,
+        kLocalToHost,
+        kReadVram,
+        kSnapshotVram,
+        kTransferSnapshot,
+        kQueueFull,
+        kSyncPointCount,
+    };
+
+    void Enqueue(Op op, const void *payload, uint32_t size);
+    void PublishLocked();
+    void RunOnWorker(SyncPoint point, const std::function<void()> &function) const;
+    void WorkerLoop();
+    void Execute(const std::vector<uint8_t> &chunk);
+    void CountWait(SyncPoint point, bool waited, std::chrono::steady_clock::time_point start) const;
+
+    std::unique_ptr<GSRasterBackend> m_inner;
+
+    mutable std::mutex m_producerMutex;
+    std::vector<uint8_t> m_open;
+    int m_lastRounding = -1;
+
+    mutable std::mutex m_queueMutex;
+    mutable std::condition_variable m_workCv;
+    mutable std::condition_variable m_doneCv;
+    std::deque<std::vector<uint8_t>> m_pending;
+    std::vector<std::vector<uint8_t>> m_spare;
+    uint64_t m_published = 0u;
+    uint64_t m_completed = 0u;
+    bool m_stop = false;
+    std::atomic<bool> m_idle{true};
+
+    bool m_stats = false;
+    mutable std::atomic<uint64_t> m_calls[kSyncPointCount]{};
+    mutable std::atomic<uint64_t> m_waits[kSyncPointCount]{};
+    mutable std::atomic<uint64_t> m_waitNs[kSyncPointCount]{};
+    mutable std::atomic<int64_t> m_lastPrintNs{0};
+
+    std::thread m_worker;
+};
