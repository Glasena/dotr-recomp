+    // PS2X_VU_RELAXED (#48): fmac() without MAC/status flags. Same math, same normalization of the result.
+    template <uint8_t Op, bool ToAcc, uint32_t Upper>
+    [[gnu::always_inline]] static inline void fmacRelaxed(VU1Interpreter &s)
+    {
+        constexpr uint8_t dest = static_cast<uint8_t>((Upper >> 21) & 0xFu);
+        if constexpr (dest != 0u)
+        {
+            constexpr int active = ((dest >> 3) & 1) | ((dest >> 1) & 2) | ((dest << 1) & 4) | ((dest << 3) & 8);
+            FmacMath m;
+            vu1fast::fmacMath<Op, ToAcc>(s.m_state, Upper, m);
+            __m128 value = m.result;
+            if ((m.ok & active) != active) [[unlikely]]
+            {
+                s.m_currentUpperInstruction = Upper; // read by normalizeFmacResult()
+                float result[4];
+                uint8_t laneFlags[4];
+                _mm_storeu_ps(result, value);
+                s.normalizeFmacResult(result, dest, laneFlags);
+                value = _mm_loadu_ps(result);
+            }
+            storeDest<dest>(ToAcc ? s.m_state.acc : s.m_state.vf[(Upper >> 6) & 0x1Fu], value);
+        }
+    }
