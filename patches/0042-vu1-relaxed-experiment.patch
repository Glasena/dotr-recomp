+        s.m_workingClip = ((s.m_workingClip << 6) | (clip & 0x3Fu)) & 0xFFFFFFu;
+        s.m_state.clip = s.m_workingClip;
+        for (uint32_t bits = s.m_flagMask; bits != 0u; bits &= bits - 1u)
+            s.m_flagPipeline[std::countr_zero(bits)].writesClip = false;
+    }
