--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -479,6 +479,20 @@
     )
 endif()
 
+# Overlay modules (runner/ov_*.cpp, one translation unit per module, recompiled separately because they share a
+# load address): many and large, rarely changed, cold compared with the main code. Keep them out of the unity
+# batches and build them at -O1 without debug info to bound build time. No PCH either: it holds the main
+# ps2_recompiled_functions.h, so regenerating the main code would rebuild every overlay.
+set(PS2X_RUNNER_OVERLAY_FILES ${RUNNER_SRC_FILES})
+list(FILTER PS2X_RUNNER_OVERLAY_FILES INCLUDE REGEX "/src/runner/ov_[^/]*\\.cpp$")
+if(PS2X_RUNNER_OVERLAY_FILES)
+    set_source_files_properties(${PS2X_RUNNER_OVERLAY_FILES} PROPERTIES
+        SKIP_UNITY_BUILD_INCLUSION ON SKIP_PRECOMPILE_HEADERS ON)
+    if(NOT MSVC)
+        set_source_files_properties(${PS2X_RUNNER_OVERLAY_FILES} PROPERTIES COMPILE_OPTIONS "-O1;-g0")
+    endif()
+endif()
+
 if(PS2X_ENABLE_RUNNER_PCH)
     set(PS2X_RUNNER_PCH_HEADERS
         "${CMAKE_CURRENT_SOURCE_DIR}/include/ps2_runtime_macros.h"
--- /dev/null
+++ b/ps2xRuntime/include/ps2_overlay_resolver.h
@@ -0,0 +1,10 @@
+#pragma once
+
+#include "ps2_runtime.h"
+
+// Optional hook for guest code that is not in the generated function table, e.g. overlay modules loaded at run time
+// at an address shared by several modules. Game code sets it (from a static initializer) to a function that returns
+// the recompiled function for `address` given the current guest RAM, or nullptr. Consulted by hasFunction() and
+// lookupFunction() only when the generated table has no entry.
+using PS2OverlayFunctionResolver = PS2Runtime::RecompiledFunction (*)(const uint8_t *rdram, uint32_t address);
+extern PS2OverlayFunctionResolver g_ps2OverlayFunctionResolver;
