+void VU1Interpreter::prepareCodeCache(const uint8_t *vuCode, uint32_t codeSize, PS2Memory *memory)
+{
+    m_codeCachePrepared = false;
+    if (codeSize / 8u > kMaxDecodedPairs)
+        return;
+    const uint32_t pairCount = codeSize / 8u;
+    const bool tracked = memory != nullptr &&
+                         ((m_unit == Unit::VU1 && vuCode == memory->getVU1Code()) ||
+                          (m_unit == Unit::VU0 && vuCode == memory->getVU0Code()));
+    const uint64_t generation = !tracked ? 0u
+                                : m_unit == Unit::VU1 ? memory->getVU1CodeGeneration()
+                                                      : memory->getVU0CodeGeneration();
+    const bool sameSource = m_decodedCodeCacheValid && m_cachedVuCode == vuCode && m_cachedMemory == memory &&
+                            m_cachedCodeSize == codeSize && m_cachedPairCount == pairCount;
+    if (!(sameSource && tracked && m_cachedCodeGeneration == generation))
+    {
+        // Games re-upload the same microprogram often; keep both caches when the bytes did not change.
+        if (!(m_decodedCodeCacheValid && m_cachedPairCount == pairCount &&
+              std::memcmp(m_cachedCodeCopy.data(), vuCode, pairCount * 8u) == 0))
+        {
+            for (uint32_t i = 0; i < pairCount; ++i)
+                m_decodedCodeCache[i] = decodeInstructionPair(vuCode, i * 8u);
+            std::memcpy(m_cachedCodeCopy.data(), vuCode, pairCount * 8u);
+            m_fastBlocks.clear();
+        }
+        m_cachedVuCode = vuCode;
+        m_cachedMemory = memory;
+        m_cachedCodeSize = codeSize;
+        m_cachedPairCount = pairCount;
+        m_cachedCodeGeneration = generation;
+        m_decodedCodeCacheValid = true;
+    }
+    if (m_fastBlocks.size() != pairCount)
+    {
+        m_fastBlocks.clear();
+        m_fastBlocks.resize(pairCount);
+    }
+    m_codeCachePrepared = true;
+}
+
+const VU1Interpreter::FastBlock *VU1Interpreter::buildFastBlock(uint32_t startPair)
+{
+    // Mirrors calculatePairReadyCycle()/markPairWrites() with every register ready at the block's first issue
+    // (offset 0). Reads of values produced before the block become liveIn requirements instead.
+    auto block = std::make_unique<FastBlock>();
+    block->startPair = startPair;
+    constexpr int64_t kNone = std::numeric_limits<int64_t>::min();
+    int64_t vf[32][4];
+    int64_t vi[16];
+    int64_t acc[4];
+    std::fill(&vf[0][0], &vf[0][0] + 32 * 4, kNone);
+    std::fill(vi, vi + 16, kNone);
+    std::fill(acc, acc + 4, kNone);
+    bool vfLive[32][4]{};
+    bool viLive[16]{};
+    bool accLive[4]{};
+    int64_t fdivReady = kNone, efuResource = kNone, efuLast = kNone;
+    int64_t t = 0;
+    bool afterDelaySlotOwner = false; // the previous pair branches or has the E bit
+
+    for (uint32_t k = 0; startPair + k < m_cachedPairCount && k < kMaxFastBlockPairs; ++k)
+    {
+        const DecodedInstructionPair &d = m_decodedCodeCache[startPair + k];
+        if (d.upperUsage.reserved || d.lowerUsage.reserved)
+            break;
+
+        int64_t ready = t;
+        const InstructionUsage *usages[2] = {&d.upperUsage, &d.lowerUsage};
+        for (const InstructionUsage *usage : usages)
+        {
+            for (uint32_t index = 0; index < usage->vfReadCount; ++index)
+            {
+                const VfAccess &access = usage->vfRead[index];
+                if (access.reg == 0u)
+                    continue;
+                for (uint32_t c = 0; c < 4u; ++c)
+                    if ((access.lanes & laneForComponent(c)) != 0u && vf[access.reg][c] != kNone)
+                        ready = std::max(ready, vf[access.reg][c]);
+            }
+            for (uint32_t bits = usage->viRead & 0xFFFEu; bits != 0u; bits &= bits - 1u)
+            {
+                const uint32_t reg = static_cast<uint32_t>(std::countr_zero(bits));
+                if (vi[reg] != kNone)
+                    ready = std::max(ready, vi[reg]);
+            }
+            for (uint32_t c = 0; c < 4u; ++c)
+                if ((usage->accRead & laneForComponent(c)) != 0u && acc[c] != kNone)
+                    ready = std::max(ready, acc[c]);
+        }
+        const InstructionUsage &lower = d.lowerUsage;
+        bool needFdiv = false, needEfu = false, needWaitP = false;
+        if (lower.pipeline == PipelineFdiv || lower.waitQ)
+        {
+            if (fdivReady != kNone)
+                ready = std::max(ready, fdivReady);
+            else
+                needFdiv = true;
+        }
+        if (lower.pipeline == PipelineEfu)
+        {
+            if (efuResource != kNone)
+                ready = std::max(ready, efuResource);
+            else
+                needEfu = true;
+        }
+        if (lower.waitP)
+        {
+            if (efuLast != kNone)
+                ready = std::max(ready, efuLast);
+            else
+                needWaitP = true;
+        }
+        const int64_t issue = ready;
+        const uint32_t issueOffset = static_cast<uint32_t>(issue);
+
+        for (const InstructionUsage *usage : usages)
+        {
+            for (uint32_t index = 0; index < usage->vfReadCount; ++index)
+            {
+                const VfAccess &access = usage->vfRead[index];
+                if (access.reg == 0u)
+                    continue;
+                for (uint32_t c = 0; c < 4u; ++c)
+                {
+                    if ((access.lanes & laneForComponent(c)) != 0u && vf[access.reg][c] == kNone &&
+                        !vfLive[access.reg][c])
+                    {
+                        vfLive[access.reg][c] = true;
+                        block->liveIn.push_back({issueOffset, 0u, access.reg, static_cast<uint8_t>(c)});
+                    }
+                }
+            }
+            for (uint32_t bits = usage->viRead & 0xFFFEu; bits != 0u; bits &= bits - 1u)
+            {
+                const uint32_t reg = static_cast<uint32_t>(std::countr_zero(bits));
+                if (vi[reg] == kNone && !viLive[reg])
+                {
+                    viLive[reg] = true;
+                    block->liveIn.push_back({issueOffset, 1u, static_cast<uint8_t>(reg), 0u});
+                }
+            }
+            for (uint32_t c = 0; c < 4u; ++c)
+            {
+                if ((usage->accRead & laneForComponent(c)) != 0u && acc[c] == kNone && !accLive[c])
+                {
+                    accLive[c] = true;
+                    block->liveIn.push_back({issueOffset, 2u, 0u, static_cast<uint8_t>(c)});
+                }
+            }
+        }
+        if (needFdiv && block->fdivReq < 0)
+            block->fdivReq = issue;
+        if (needEfu && block->efuReq < 0)
+            block->efuReq = issue;
+        if (needWaitP && block->waitPReq < 0)
+            block->waitPReq = issue;
+
+        // markPairWrites()
+        const VfAccess lowerWrite = lower.vfWrite;
+        if (lowerWrite.reg != 0u && d.suppressedLowerVf != lowerWrite.reg)
+        {
+            const int64_t at = issue + (lower.vfLatency != 0u ? lower.vfLatency : lower.latency);
+            for (uint32_t c = 0; c < 4u; ++c)
+                if ((lowerWrite.lanes & laneForComponent(c)) != 0u)
+                    vf[lowerWrite.reg][c] = at;
+        }
+        const VfAccess upperWrite = d.upperUsage.vfWrite;
+        if (upperWrite.reg != 0u)
+        {
+            const int64_t at = issue + (d.upperUsage.vfLatency != 0u ? d.upperUsage.vfLatency : d.upperUsage.latency);
+            for (uint32_t c = 0; c < 4u; ++c)
+                if ((upperWrite.lanes & laneForComponent(c)) != 0u)
+                    vf[upperWrite.reg][c] = at;
+        }
+        for (uint32_t bits = lower.viWrite & 0xFFFEu; bits != 0u; bits &= bits - 1u)
+            vi[std::countr_zero(bits)] = issue + (lower.viLatency != 0u ? lower.viLatency : lower.latency);
+        for (uint32_t c = 0; c < 4u; ++c)
+            if ((d.upperUsage.accWrite & laneForComponent(c)) != 0u)
+                acc[c] = issue + kAccForwardLatency;
+
+        // queueQ()/queueP() timing
+        if (lower.pipeline == PipelineFdiv && !lower.waitQ)
+            fdivReady = issue + lower.latency;
+        if (lower.pipeline == PipelineEfu && !lower.waitP)
+        {
+            efuResource = issue + (lower.latency > 0u ? lower.latency - 1u : 0u);
+            efuLast = issue + lower.latency;
+        }
+
+        block->issue.push_back(issueOffset);
+        t = issue + 1;
+        if (afterDelaySlotOwner)
+            break;
+        afterDelaySlotOwner = lower.pipeline == PipelineBranch || d.eBit;
+    }
+
+    block->pairCount = static_cast<uint32_t>(block->issue.size());
+    for (uint32_t reg = 1; reg < 32u; ++reg)
+        for (uint32_t c = 0; c < 4u; ++c)
+            if (vf[reg][c] != kNone)
+                block->exitReady.push_back({static_cast<uint32_t>(vf[reg][c]), 0u, static_cast<uint8_t>(reg),
+                                            static_cast<uint8_t>(c)});
+    for (uint32_t reg = 1; reg < 16u; ++reg)
+        if (vi[reg] != kNone)
+            block->exitReady.push_back({static_cast<uint32_t>(vi[reg]), 1u, static_cast<uint8_t>(reg), 0u});
+    for (uint32_t c = 0; c < 4u; ++c)
+        if (acc[c] != kNone)
+            block->exitReady.push_back({static_cast<uint32_t>(acc[c]), 2u, 0u, static_cast<uint8_t>(c)});
+
+    const uint32_t span = block->pairCount != 0u ? block->issue.back() + 1u : 0u;
+    for (const FastReady &w : block->exitReady)
+        if (w.offset > span)
+            block->exitLate.push_back(w);
+
+    m_fastBlocks[startPair] = std::move(block);
+    return m_fastBlocks[startPair].get();
+}
+
+void VU1Interpreter::applyPendingRegisterWrites()
+{
+    // Interpreter writes still in flight become visible now. Every reader stalls until their ready cycle anyway,
+    // so only the latest write of each lane matters, as in commitReadyPipelines().
+    for (uint32_t bits = m_vfMask; bits != 0u; bits &= bits - 1u)
+    {
+        const PendingVfWrite &write = m_vfWritePipeline[std::countr_zero(bits)];
+        for (uint32_t c = 0; c < 4u; ++c)
+            if ((write.laneMask & laneForComponent(c)) != 0u && m_vfLatestWrite[write.reg][c] == write.sequence)
+                m_state.vf[write.reg][c] = write.value[c];
+        m_vfWritePipeline[std::countr_zero(bits)].valid = false;
+    }
+    for (uint32_t bits = m_viMask; bits != 0u; bits &= bits - 1u)
+    {
+        PendingViWrite &write = m_viWritePipeline[std::countr_zero(bits)];
+        if (m_viLatestWrite[write.reg] == write.sequence)
+            m_state.vi[write.reg] = static_cast<int16_t>(write.value);
+        write.valid = false;
+    }
+    for (uint32_t bits = m_accMask; bits != 0u; bits &= bits - 1u)
+    {
+        PendingAccWrite &write = m_accWritePipeline[std::countr_zero(bits)];
+        for (uint32_t c = 0; c < 4u; ++c)
+            if ((write.laneMask & laneForComponent(c)) != 0u && m_accLatestWrite[c] == write.sequence)
+                m_state.acc[c] = write.value[c];
+        write.valid = false;
+    }
+    m_vfMask = m_viMask = m_accMask = 0u;
+}
+
+bool VU1Interpreter::tryEnterFastBlock(uint64_t budgetEnd)
+{
+    static const bool disabled = std::getenv("PS2X_VU_NO_BLOCKS") != nullptr;
+    if (disabled || !m_codeCachePrepared || (m_state.pc & 7u) != 0u || m_state.branchPending ||
+        m_state.haltAfterDelaySlot || m_storeMask != 0u)
+        return false;
+    const uint32_t pair = m_state.pc / 8u;
+    if (pair >= m_fastBlocks.size())
+        return false;
+    const FastBlock *block = m_fastBlocks[pair] ? m_fastBlocks[pair].get() : buildFastBlock(pair);
+    if (block->pairCount == 0u)
+        return false;
+
+    const uint64_t start = m_cycle;
+    // Register results become visible at issue in block mode. Keep the block and the few cycles until its last
+    // results would commit inside the budget, so a run cut by the budget leaves the interpreter's state.
+    if (start + block->issue.back() + 16u >= budgetEnd)
+        return false;
+    if (m_regReadyMax > start)
+    {
+        for (const FastReady &req : block->liveIn)
+        {
+            if (start + req.offset >= m_regReadyMax)
+                break; // no ready cycle exceeds m_regReadyMax
+            const uint64_t ready = req.kind == 0u   ? m_vfReady[req.reg][req.component]
+                                   : req.kind == 1u ? m_viReady[req.reg]
+                                                    : m_accReady[req.component];
+            if (ready > start + req.offset)
+                return false;
+        }
+    }
+    if (block->fdivReq >= 0 && m_fdiv.valid && m_fdiv.readyCycle > start + static_cast<uint64_t>(block->fdivReq))
+        return false;
+    if (block->efuReq >= 0 && m_efuResourceReady > start + static_cast<uint64_t>(block->efuReq))
+        return false;
+    if (block->waitPReq >= 0)
+    {
+        for (const ScalarPipelineEntry &entry : m_efu)
+            if (entry.valid && entry.readyCycle > start + static_cast<uint64_t>(block->waitPReq))
+                return false;
+    }
+
+    applyPendingRegisterWrites();
+    m_fastBlock = block;
+    m_fastIndex = 0;
+    m_fastStart = start;
+    m_xgkickSyncCycle = m_cycle; // advanceOneCycle() has run PATH1 through this boundary
+    return true;
+}
+
+void VU1Interpreter::exitFastBlock()
+{
+    const FastBlock &block = *m_fastBlock;
+    catchUpXgkick(m_cycle);
+    m_fastBlock = nullptr; // queueStore() and friends are back to the interpreter's pipelines
+    if (m_fastIndex == block.pairCount)
+    {
+        // When nothing from before the block can still stall (m_regReadyMax <= now), ready cycles already passed
+        // are equivalent to any other past cycle, so only the writes still pending need recording.
+        const std::vector<FastReady> &writes = m_regReadyMax <= m_cycle ? block.exitLate : block.exitReady;
+        for (const FastReady &w : writes)
+        {
+            const uint64_t ready = m_fastStart + w.offset;
+            if (w.kind == 0u)
+            {
+                m_vfReady[w.reg][w.component] = ready;
+                m_vfRegReadyMax[w.reg] = std::max(m_vfRegReadyMax[w.reg], ready);
+            }
+            else if (w.kind == 1u)
+                m_viReady[w.reg] = ready;
+            else
+                m_accReady[w.component] = ready;
+            m_regReadyMax = std::max(m_regReadyMax, ready);
+        }
+        return;
+    }
+    // Left early: replay the ready cycles of the pairs that ran.
+    const uint64_t cycle = m_cycle;
+    for (uint32_t k = 0; k < m_fastIndex; ++k)
+    {
+        m_cycle = m_fastStart + block.issue[k];
+        markPairWrites(m_decodedCodeCache[block.startPair + k]);
+    }
+    m_cycle = cycle;
+}
+
+void VU1Interpreter::fastAdvanceTo(uint64_t targetCycle)
+{
+    // Commit at each intermediate ready cycle: entries ready at different cycles must apply in that order.
+    while (m_nextCommitCycle < targetCycle)
+    {
+        m_cycle = m_nextCommitCycle;
+        commitReadyPipelines();
+    }
+    m_cycle = targetCycle;
+    commitReadyPipelines();
+}
+
+void VU1Interpreter::catchUpXgkick(uint64_t throughCycle)
+{
+    while (m_xgkick.active && m_xgkickSyncCycle < throughCycle)
+    {
+        ++m_xgkickSyncCycle;
+        progressXgkick();
+    }
+    m_xgkickSyncCycle = std::max(m_xgkickSyncCycle, throughCycle);
+}
+
 void VU1Interpreter::run(uint8_t *vuCode, uint32_t codeSize,
                          uint8_t *vuData, uint32_t dataSize,
                          GS &gs, PS2Memory *memory, uint32_t maxCycles)
@@ -1708,18 +2080,161 @@ void VU1Interpreter::run(uint8_t *vuCode, uint32_t codeSize,
     m_activeVuDataSize = dataSize;
     m_activeGs = &gs;
     m_activeMemory = memory;
+    prepareCodeCache(vuCode, codeSize, memory);
 
     const int previousRoundingMode = std::fegetround();
     const bool useVuRounding = std::fesetround(FE_TOWARDZERO) == 0;
     const uint64_t budgetEnd = m_cycle + maxCycles;
     bool programEnded = false;
+
+    // Executes one pair's upper and lower instructions; register results land in m_state right away.
+    auto executePair = [&](const DecodedInstructionPair &decoded)
+    {
+        if (decoded.iBit)
+        {
+            execUpper(decoded.upper);
+            float immediate = 0.0f;
+            std::memcpy(&immediate, &decoded.lower, sizeof(immediate));
+            m_state.i = normalizeOperand(immediate);
+        }
+        else if (decoded.upperVfShadowReg != 0u)
+        {
+            float oldVf[4]{};
+            float upperVf[4]{};
+            std::memcpy(oldVf,
+                        m_state.vf[decoded.upperVfShadowReg],
+                        sizeof(oldVf));
+            execUpper(decoded.upper);
+            std::memcpy(upperVf,
+                        m_state.vf[decoded.upperVfShadowReg],
+                        sizeof(upperVf));
+            std::memcpy(m_state.vf[decoded.upperVfShadowReg],
+                        oldVf,
+                        sizeof(oldVf));
+            execLower(decoded.lower, vuData, dataSize, gs, memory, decoded.upper);
+            std::memcpy(m_state.vf[decoded.upperVfShadowReg],
+                        upperVf,
+                        sizeof(upperVf));
+        }
+        else
+        {
+            execUpper(decoded.upper);
+            execLower(decoded.lower, vuData, dataSize, gs, memory, decoded.upper);
+        }
+    };
+
+    // PC, branch delay and E/D/T-bit handling after a pair; returns true when the program ends.
+    auto finishPair = [&](const DecodedInstructionPair &decoded)
+    {
