+        std::string fileHeader(const std::string &body, const std::string &selfName)
+        {
+            std::stringstream ss;
+            ss << "#include <stdexcept>\n";
+            ss << "#include \"ps2_runtime_macros.h\"\n";
+            if (body.find("ps2_syscalls::") != std::string::npos)
+            {
+                ss << "#include \"ps2_syscalls.h\"\n";
+            }
+            if (body.find("ps2_stubs::") != std::string::npos)
+            {
+                ss << "#include \"ps2_stubs.h\"\n";
+            }
+            ss << "\n#ifdef PS2_FUNCTION_LOG_TRACKER\n";
+            ss << "#include \"ps2_log.h\"\n";
+            ss << "#endif\n\n";
+
+            static constexpr std::string_view callArgs = "(rdram, ctx, runtime)";
+            std::set<std::string> callees;
+            for (size_t pos = body.find(callArgs); pos != std::string::npos; pos = body.find(callArgs, pos + 1))
+            {
+                size_t start = pos;
+                while (start > 0 && (std::isalnum(static_cast<unsigned char>(body[start - 1])) || body[start - 1] == '_'))
+                {
+                    --start;
+                }
+                if (start == pos || (start > 0 && body[start - 1] == ':'))
+                {
+                    continue;
+                }
+                std::string callee = body.substr(start, pos - start);
+                if (callee != selfName)
+                {
+                    callees.insert(std::move(callee));
+                }
+            }
+            for (const std::string &callee : callees)
+            {
+                ss << "void " << callee << "(uint8_t* rdram, R5900Context* ctx, PS2Runtime *runtime);\n";
+            }
+            if (!callees.empty())
+            {
+                ss << "\n";
+            }
+            return ss.str();
+        }
     }
 
