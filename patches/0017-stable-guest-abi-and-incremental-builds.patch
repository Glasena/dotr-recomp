+    }
+    std::cout << "Status: 0x" << std::setw(8) << cop0_status
+              << " Cause: 0x" << std::setw(8) << cop0_cause
+              << " EPC: 0x" << std::setw(8) << cop0_epc << "\n";
+    std::cout << "--- End Context Dump ---\n";
+    std::cout.flags(flags); // Restore format flags
+}
