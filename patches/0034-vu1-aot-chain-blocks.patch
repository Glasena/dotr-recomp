+int Vu1Aot::enterNext(VU1Interpreter &s, Vu1AotRun &r)
+{
+    if (s.m_cycle >= r.budgetEnd || s.m_stopRequested)
+        return kAotDone;
+    s.commitReadyPipelines();
+    const uint32_t pc = s.m_state.pc;
+    if (pc + 8u > r.codeSize)
+        return kAotDone;
+    // Only a block that is built and bound to generated code; run() builds the others.
+    const DirectIds &ids = *static_cast<const DirectIds *>(r.ids);
+    const uint32_t pair = pc / 8u;
+    if ((pc & 7u) != 0u || pair >= s.m_fastBlocks.size() || !s.m_fastBlocks[pair] || pair >= ids.aot.size() ||
+        !ids.aot[pair] || s.m_state.ebit)
+        return kAotDone;
+    if (!s.tryEnterFastBlock(r.budgetEnd))
+    {
+        r.refused = true;
+        return kAotDone;
+    }
+    FlagElision &e = *r.flags; // onBlockEnter()
+    e.blockElide = !noElide && !ids.elide[pair].empty() ? ids.elide[pair].data() : nullptr;
+    e.count = 0u;
+    e.stickyCarry = 0u;
+    if (g_vuStats)
+    {
+        ++vuStats().blocks;
+        ++vuStats().chainedBlocks;
+        if (vuStats().current)
+            ++vuStats().current->blocks;
+    }
+    r.issue = s.m_fastBlock->issue.data();
+    r.startPair = pair;
+    r.next = ids.aot[pair];
+    return kAotNext;
+}
