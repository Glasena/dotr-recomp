diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
index daa297d..08bddc1 100644
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
@@ -3657,6 +3657,22 @@ void VU1Interpreter::run(uint8_t *vuCode, uint32_t codeSize,
 
     if (programEnded)
     {
+        // A fast block or generated code writes VF/VI/ACC at issue and queues nothing, so flushPipelines() alone
+        // would not wait for a write still in flight (#45). The lane ready cycles equal the ready cycles of the
+        // writes the interpreter queues, so waiting for the last one first gives the same end cycle.
+        if (m_regReadyMax > m_cycle)
+        {
+            uint64_t end = m_cycle;
+            for (uint32_t reg = 1; reg < 32u; ++reg)
+                if (m_vfRegReadyMax[reg] > end)
+                    for (uint32_t c = 0; c < 4u; ++c)
+                        end = std::max(end, m_vfReady[reg][c]);
+            for (uint32_t reg = 1; reg < 16u; ++reg)
+                end = std::max(end, m_viReady[reg]);
+            for (uint32_t c = 0; c < 4u; ++c)
+                end = std::max(end, m_accReady[c]);
+            advanceTo(end);
+        }
         flushPipelines();
         m_state.ebit = false;
         m_state.haltAfterDelaySlot = false;
